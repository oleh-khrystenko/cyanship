{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [".env"],
    "tasks": {
        "dev": {
            "cache": false,
            "dependsOn": ["^dev"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "dist/**"]
        },
        "lint": { "outputs": [] },
        "test": { "cache": false }
    }
}
