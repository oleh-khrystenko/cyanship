# ===================
# Runtime
# ===================
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000

# ===================
# Backend (apps/api)
# ===================
# Origin сайту. Використовується і бекендом (CORS, посилання в листах,
# Stripe return URLs), і фронтом — next.config.ts інлайнить його як
# NEXT_PUBLIC_BASE_URL, окремої змінної для web немає.
WEB_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<app>

REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<generate-random-32-byte-hex>
JWT_REFRESH_SECRET=<generate-random-32-byte-hex>

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

RESEND_API_KEY=re_your_resend_api_key
# Production: verified domain sender (e.g. CyanShip <no-reply@cyanship.com>)
RESEND_FROM_EMAIL=CyanShip <onboarding@resend.dev>

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Test key for development: 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
BRIEF_NOTIFICATION_EMAIL=your-email@example.com

# --- AI Chat ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- Cloudflare R2 (media storage) ---
# R2_PUBLIC_URL — єдине джерело хоста медіа: next.config.ts бере з нього
# hostname для next/image і базу для публічних ассетів на фронті.
# Тільки origin (протокол + хост): без шляху і без слеша в кінці —
# інакше збірка web падає, бо API склеює ключі саме з цим рядком.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cyanship-media
R2_PUBLIC_URL=https://media.cyanship.com

# ===================
# Frontend (apps/web)
# ===================
# Внутрішня адреса API: next.config.ts проксує /api/* сюди. Обов'язкова —
# браузер ходить тільки на /api того ж origin, без цього проксі не працює
# нічого. Тільки origin, без шляху і слеша в кінці.
API_INTERNAL_URL=http://localhost:4000

# Test key for development: 1x00000000000000000000AA (always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Demo video — шляхи в бакеті R2 (склеюються з R2_PUBLIC_URL).
# Обидва optional; постер без відео = помилка збірки.
NEXT_PUBLIC_DEMO_VIDEO_PATH=/demo/<video-file>.<format>
NEXT_PUBLIC_DEMO_VIDEO_POSTER_PATH=/demo/<poster-file>.<format>
